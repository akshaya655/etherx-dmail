PINATA_JWT=your_pinata_jwt_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 Mail Domain — change this single variable to migrate domains
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Default: etherxinnovations.in (Cloudflare DNS + Email Routing)
# To switch to a custom SMTP provider in future, only update:
#   MAIL_DOMAIN, SMTP_DOMAIN, SMTP_FROM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MAIL_DOMAIN=etherxinnovations.in
SMTP_DOMAIN=etherxinnovations.in
SMTP_FROM=DMail <noreply@etherxinnovations.in>

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📬 SMTP (Gmail — no changes needed for free testing)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📥 IMAP (Gmail relay — no changes needed for free testing)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_gmail@gmail.com
IMAP_PASSWORD=your_app_password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌍 How to Enable Global Cross-Device Mail
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DMail uses Pinata to pin mail content to the public
# IPFS network securely. This is required for messages
# to be readable across different devices and networks.
#
# 1. Create a free account at: https://app.pinata.cloud/register
# 2. Go to "API Keys" -> "New Key"
# 3. Enable "pinJSONToIPFS" and "pinFileToIPFS"
# 4. Copy the long JWT token
# 5. Rename this file to `.env` and paste your JWT above
# 6. Restart this relay server
#
# Since this JWT is securely stored on your backend, your
# end users do NOT need to configure anything. They will 
# automatically get global communication!
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
